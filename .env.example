# SONORA – AI Instrument Audio Cleaner
# Copy this file to .env and adjust values as needed.

# --- Backend Server ---
SONORA_APP_NAME=SONORA
SONORA_ENV=development
SONORA_HOST=127.0.0.1
SONORA_PORT=8000
SONORA_LOG_LEVEL=INFO

# Comma-separated list of allowed frontend origins
SONORA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Audio Safety & Storage Limits ---
# Temporary workspace directory for uploaded/processed audio sessions.
# Leave blank to use the system temp directory under /sonora_sessions.
SONORA_TEMP_DIR=
SONORA_SESSION_TTL_MINUTES=60
SONORA_MAX_UPLOAD_MB=150
SONORA_MAX_DURATION_SECONDS=900
SONORA_MAX_DECODED_PCM_MB=512

# --- External Media Tools ---
# Leave blank to auto-detect on system PATH.
SONORA_FFMPEG_PATH=
SONORA_FFPROBE_PATH=

# --- Processing Concurrency ---
SONORA_MAX_WORKERS=2

# --- Frontend (Vite) ---
# Empty string uses the Vite dev server proxy (/api -> http://127.0.0.1:8000)
VITE_API_BASE_URL=
